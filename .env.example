# Optional Elfsight widgets (https://elfsight.com) — auto-sync Instagram/Facebook feeds
VITE_ELFSIGHT_INSTAGRAM_WIDGET_ID=
VITE_ELFSIGHT_FACEBOOK_WIDGET_ID=

# Optional — full YouTube channel sync via Data API
VITE_YOUTUBE_API_KEY=

# Required for Facebook post carousel thumbnails (Meta → Page Access Token)
# 1. developers.facebook.com → Create app → Add Facebook Login / Graph API
# 2. Connect JamiatAhleHadeesOfficialHydSec page → Generate long-lived Page token
# 3. Paste token below, restart dev server, then run: npm run sync:facebook
VITE_FACEBOOK_ACCESS_TOKEN=
